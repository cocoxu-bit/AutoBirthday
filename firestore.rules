rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bloquear todo acceso no autenticado por defecto
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Regla para usuarios y todas sus subcolecciones (contactos, plantillas, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Regla para la colección global de felicitaciones (wishes)
    match /wishes/{wishId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Bloqueo explícito por defecto para cualquier otra ruta no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
